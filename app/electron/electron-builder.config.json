{
  "appId": "br.com.axyo.orbit",
  "productName": "Orbit",
  "directories": {
    "buildResources": "resources"
  },
  "files": [
    "assets/**/*",
    "build/**/*",
    "capacitor.config.*",
    "app/**/*"
  ],
  "extraResources": [
    { "from": "../../server.py", "to": "server.py" }
  ],
  "publish": null,
  "afterPack": "scripts/afterPack.js",
  "nsis": {
    "allowElevation": true,
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "win": {
    "target": "nsis",
    "icon": "assets/appIcon.ico"
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": "dmg",
    "identity": null,
    "icon": "assets/appIcon.png"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "assets/icons",
    "category": "Utility",
    "maintainer": "Axyo <ti@axyo.com.br>"
  }
}